# Firebase Configuration for ConnectCall
# Obtain these from your Firebase Project Console -> Project Settings -> General -> Your apps (Web)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional TURN Server Configuration for WebRTC in restrictive NAT/firewall networks
# If omitted, public Google STUN servers (stun:stun.l.google.com:19302) are used by default.
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# Application URL
APP_URL="MY_APP_URL"

